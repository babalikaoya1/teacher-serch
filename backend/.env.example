DATABASE_URL=sqlite:///./teacher_search.db
MAP_WEB_SDK_URL=
MAP_WEB_PUBLIC_KEY=
MAP_WEB_SERVICE_KEY=
MAP_WEB_SECURITY_CODE=
LLM_CHAT_COMPLETIONS_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# 本地 development；公网必须为 production，并配置 PostgreSQL 与 HTTPS 域名。
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYNC_WORKER_ENABLED=true
AI_REQUESTS_PER_MINUTE=10
MAP_REQUESTS_PER_MINUTE=60
SYNC_BATCHES_PER_MINUTE=120
# 不填时使用项目 desktop_helper/dist 下的助手安装包。
WECHAT_HELPER_PACKAGE=
# 仅显式迁移历史订单时使用；留空则由初始化命令交互输入。
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=
